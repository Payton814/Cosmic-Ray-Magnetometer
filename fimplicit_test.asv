
myCone(0,0,0)

%fimplicit3(test, [-2 2 -2 2 -2 2], 'EdgeColor', 'none', 'FaceAlpha', 0.6)
xlabel('X'); ylabel('Y'); zlabel('Z');


function f = test(x,y,z)
f = x.^2 + y.^2 - z.^2 - 1;
end



function f = myCone(x, y, z)
x0 = 0;
y0 = 0;
z0 = 0;
theta = 0;
phi = 0;
alpha = 90;
a = ((x - x0)*cos(phi) - (y - y0)*sin(phi)).^2;
b = (((x - x0)*sin(phi) + (y - y0)*cos(phi))*cos(theta) - (z - z0)*sin(theta)).^2;
c = (((x - x0)*sin(phi) + (y - y0)*cos(phi))*sin(theta) + (z - z0)*cos(theta)).^2;
f = c*tan(alpha/2) - b - a;
end
%% 


%fimplicit3(c, [-2 2 -2 2 -2 2], 'EdgeColor', 'none', 'FaceAlpha', 0.6)
%xlabel('X'); ylabel('Y'); zlabel('Z');